---
interface Props {
  title: string;
  links: { href: string; label: string; current?: boolean }[];
}
const { title, links } = Astro.props;
---

<section aria-label={title}>
  <h2 class="h-section mb-4">{title}</h2>
  <ul class="flex flex-wrap gap-2">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class:list={['chip', link.current && 'is-active']} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
