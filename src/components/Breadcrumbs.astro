---
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="hide-in-fs text-sm text-ink-3">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <Icon name="chevron" size={14} class="rtl:rotate-180" />}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-ink-2">{item.label}</span>
          ) : (
            <a href={item.href} class="hover:text-ink">{item.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
