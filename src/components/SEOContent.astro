---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="seo-content mx-auto max-w-4xl px-4 py-12">
  <h2 class="mb-6 font-display text-2xl font-bold text-slate-50 md:text-3xl">
    {title}
  </h2>
  <div class="prose-sm space-y-4 leading-relaxed text-slate-400">
    <slot />
  </div>
</section>
