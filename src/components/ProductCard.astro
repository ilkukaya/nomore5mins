---
export interface Product {
  name: string;
  description: string;
  price: string;
  category: string;
  tag: string;
  asin: string;
  image: string;
}

interface Props {
  product: Product;
  affiliateTag?: string;
}

const { product, affiliateTag = 'nomore5mins-20' } = Astro.props;
const amazonUrl = `https://www.amazon.com/dp/${product.asin}?tag=${affiliateTag}&linkCode=ogi&th=1`;

// Emoji icons per product image type
const icons: Record<string, string> = {
  pillow: '🛏️',
  mask: '😴',
  noise: '🔊',
  sunrise: '🌅',
  blanket: '🧣',
  tracker: '📱',
  headphones: '🎧',
  cubetimer: '⏱️',
  glasses: '👓',
  desk: '🖥️',
  fitwatch: '⌚',
  yogamat: '🧘',
};

const icon = icons[product.image] || '📦';

// Tag colors
const tagColors: Record<string, string> = {
  'Best Seller': 'bg-amber-500/20 text-amber-400 border-amber-500/30',
  'Top Rated': 'bg-green-500/20 text-green-400 border-green-500/30',
  'Popular': 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  "Editor's Pick": 'bg-purple-500/20 text-purple-400 border-purple-500/30',
  'Best Value': 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
  'Premium': 'bg-rose-500/20 text-rose-400 border-rose-500/30',
};

const tagClass = tagColors[product.tag] || 'bg-slate-500/20 text-slate-400 border-slate-500/30';
---

<a
  href={amazonUrl}
  target="_blank"
  rel="nofollow noopener sponsored"
  class="card group flex flex-col transition-all hover:border-amber-500/60 hover:shadow-lg hover:shadow-amber-500/5"
>
  <!-- Tag -->
  <div class="mb-3">
    <span class={`inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium ${tagClass}`}>
      {product.tag}
    </span>
  </div>

  <!-- Icon -->
  <div class="mb-3 text-4xl">{icon}</div>

  <!-- Name -->
  <h3 class="mb-1 font-display text-base font-semibold text-slate-50 group-hover:text-amber-400 transition-colors">
    {product.name}
  </h3>

  <!-- Description -->
  <p class="mb-3 flex-1 text-sm leading-relaxed text-slate-400">{product.description}</p>

  <!-- Price + CTA -->
  <div class="flex items-center justify-between">
    <span class="font-clock text-lg text-amber-500">{product.price}</span>
    <span class="rounded-lg bg-amber-500/10 px-3 py-1 text-xs font-medium text-amber-400 transition-colors group-hover:bg-amber-500 group-hover:text-slate-950">
      View on Amazon
    </span>
  </div>
</a>
