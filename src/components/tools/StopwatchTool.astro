---
import Icon from '../Icon.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  data-tool="stopwatch"
  data-i18n={JSON.stringify(t.client)}
  data-labels={JSON.stringify({ start: t.common.start, pause: t.common.pause, resume: t.common.resume, lap: t.common.lap, reset: t.common.reset })}
>
  <div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <section class="stage relative flex min-h-[300px] flex-col items-center justify-center md:min-h-[400px]" data-fs-target>
      <button type="button" class="btn btn-ghost btn-icon absolute end-3 top-3" data-fullscreen aria-label={t.common.fullscreen} title={`${t.common.fullscreen} (F)`}>
        <Icon name="expand" size={18} />
      </button>
      <div class="digits digits-lg" role="timer" aria-live="off" data-display>00:00.00</div>
      <p class="digits mt-3 text-lg text-ink-3" data-current-lap>&nbsp;</p>
      <div class="mt-8 flex items-center justify-center gap-3">
        <button type="button" class="btn btn-ghost btn-lg min-w-32" data-secondary disabled>
          <span data-secondary-label>{t.common.lap}</span>
        </button>
        <button type="button" class="btn btn-primary btn-lg min-w-40" data-primary>
          <span data-primary-label>{t.common.start}</span>
        </button>
      </div>
      <p class="mt-5 hidden gap-3 text-xs text-ink-3 md:flex">
        <span><kbd>Space</kbd> {t.common.start}/{t.common.pause}</span>
        <span><kbd>L</kbd> {t.common.lap}</span>
        <span><kbd>R</kbd> {t.common.reset}</span>
        <span><kbd>F</kbd> {t.common.fullscreen}</span>
      </p>
    </section>

    <section class="panel flex min-h-[200px] flex-col p-5 sm:p-6" aria-labelledby="laps-title">
      <h2 id="laps-title" class="mb-3 text-lg font-bold">{t.stopwatch.lapsTitle}</h2>
      <div class="max-h-[420px] flex-1 overflow-y-auto">
        <table class="w-full text-[0.9375rem]">
          <thead class="sticky top-0 bg-surface text-start text-xs uppercase tracking-wide text-ink-3">
            <tr>
              <th class="py-2 text-start font-semibold">{t.stopwatch.lapCol}</th>
              <th class="py-2 text-end font-semibold">{t.stopwatch.splitCol}</th>
              <th class="py-2 text-end font-semibold">{t.stopwatch.totalCol}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line" data-laps></tbody>
        </table>
        <p class="py-6 text-center text-sm text-ink-3" data-laps-empty>—</p>
      </div>
    </section>
  </div>
</div>

<script>
  import { initStopwatch } from '../../scripts/tools/stopwatch';
  document.querySelectorAll<HTMLElement>('[data-tool="stopwatch"]').forEach(initStopwatch);
</script>
