---
import Icon from '../Icon.astro';
import SoundPicker from './SoundPicker.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const R = 46;
const C = 2 * Math.PI * R;
---

<div
  data-tool="pomodoro"
  data-i18n={JSON.stringify(t.client)}
  data-labels={JSON.stringify({ pause: t.common.pause, resume: t.common.resume })}
>
  <div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <section class="stage relative flex min-h-[360px] flex-col items-center justify-center md:min-h-[440px]" data-fs-target>
      <button type="button" class="btn btn-ghost btn-icon absolute end-3 top-3" data-fullscreen aria-label={t.common.fullscreen}>
        <Icon name="expand" size={18} />
      </button>
      <div class="segmented mt-10 max-w-full sm:mt-0" role="group" aria-label={t.client.focus}>
        <button type="button" data-phase-btn="focus" aria-pressed="true">{t.client.focus}</button>
        <button type="button" data-phase-btn="short" aria-pressed="false">{t.client.shortBreak}</button>
        <button type="button" data-phase-btn="long" aria-pressed="false">{t.client.longBreak}</button>
      </div>

      <div class="ring-box relative mt-6 grid aspect-square w-full max-w-[min(72vw,340px)] place-items-center">
        <svg class="absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r={R} fill="none" stroke-width="2.5" class="ring-track"></circle>
          <circle cx="50" cy="50" r={R} fill="none" stroke-width="2.5" stroke-linecap="round" class="ring-bar" stroke-dasharray={C} stroke-dashoffset="0" data-ring></circle>
        </svg>
        <div class="text-center">
          <div class="digits digits-md" role="timer" aria-live="off" data-display>25:00</div>
          <p class="mt-2 text-sm font-medium text-ink-3" data-session></p>
        </div>
      </div>

      <div class="mt-6 flex w-full items-center justify-center gap-3">
        <button type="button" class="btn btn-ghost btn-lg w-[60px] flex-none px-0" data-reset aria-label={t.common.reset}>
          <Icon name="reset" />
        </button>
        <button type="button" class="btn btn-primary btn-lg min-w-0 max-w-64 flex-1 px-4" data-start>
          <span data-start-label>{t.client.startFocus}</span>
        </button>
        <button type="button" class="btn btn-ghost btn-lg w-[60px] flex-none px-0" data-skip aria-label={t.pomodoro.skip} title={t.pomodoro.skip}>
          <Icon name="skip" />
        </button>
      </div>
    </section>

    <div class="grid content-start gap-4">
      <section class="panel p-5 sm:p-6" aria-labelledby="pomo-today">
        <h2 id="pomo-today" class="eyebrow mb-3">{t.pomodoro.todayTitle}</h2>
        <div class="flex min-h-9 flex-wrap gap-1.5" data-dots></div>
        <p class="mt-3 text-sm text-ink-2" data-focused></p>
      </section>

      <details class="panel p-5 sm:p-6" data-settings>
        <summary class="cursor-pointer text-lg font-bold">{t.pomodoro.settingsTitle}</summary>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <label><span class="field-label">{t.pomodoro.focusLen}</span><input class="input" type="number" min="1" max="180" value="25" data-set="focus" /></label>
          <label><span class="field-label">{t.pomodoro.shortLen}</span><input class="input" type="number" min="1" max="60" value="5" data-set="short" /></label>
          <label><span class="field-label">{t.pomodoro.longLen}</span><input class="input" type="number" min="1" max="90" value="15" data-set="long" /></label>
          <label><span class="field-label">{t.pomodoro.rounds}</span><input class="input" type="number" min="2" max="12" value="4" data-set="rounds" /></label>
        </div>
        <label class="mt-4 flex items-center gap-3 text-[0.9375rem]">
          <input type="checkbox" data-set="auto" />
          {t.pomodoro.autoStart}
        </label>
        <div class="mt-4">
          <SoundPicker locale={locale} id="pomodoro" defaultSound="gentle-chime" />
        </div>
      </details>
    </div>
  </div>
</div>

<script>
  import { initPomodoro } from '../../scripts/tools/pomodoro';
  document.querySelectorAll<HTMLElement>('[data-tool="pomodoro"]').forEach(initPomodoro);
</script>
