---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  id?: string;
}

const { items, id } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section id={id} class="mx-auto max-w-3xl py-8">
  <div class="space-y-2">
    {
      items.map((item) => (
        <details class="faq-item card">
          <summary class="text-sm font-semibold md:text-base">
            {item.question}
          </summary>
          <div class="faq-content text-sm leading-relaxed">{item.answer}</div>
        </details>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
