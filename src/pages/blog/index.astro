---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { absoluteUrl, formatDate } from '../../i18n';

const posts = (await getCollection('blog')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'NoMore5Mins Blog',
    url: absoluteUrl('/blog/'),
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: absoluteUrl(`/blog/${p.id}/`),
      datePublished: p.data.published.toISOString(),
    })),
  },
];
---

<PageLayout
  title="Blog — Sleep, Focus & Time Management Guides | NoMore5Mins"
  description="Practical guides on waking up early, beating the snooze button, the Pomodoro technique, study timers and time management."
  path="/blog/"
  h1="Guides for better mornings and deeper focus"
  intro="Practical, evidence-informed articles about sleep, waking up and getting things done."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }]}
  jsonLd={jsonLd}
>
  <ul slot="after" class="grid gap-3">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="panel-flat block p-5 transition-colors hover:border-line-strong">
            <p class="text-xs text-ink-3">{formatDate('en', post.data.published)}</p>
            <p class="mt-1 text-lg font-bold text-ink">{post.data.title}</p>
            <p class="mt-1 text-[0.9375rem] text-ink-2">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
