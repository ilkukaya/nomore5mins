# Copy to .env for local builds, or set these as environment variables on your host
# (Netlify: Site configuration → Environment variables; Cloudflare Pages: Settings → Variables;
#  GitHub Actions: Settings → Secrets and variables → Actions → Variables).
# All are optional: the site works without any of them.

# Your final domain, without trailing slash (canonical URLs, hreflang, sitemap, OG images).
PUBLIC_SITE_URL=https://nomore5mins.netlify.app

# Google AdSense publisher ID (also generates /ads.txt). Leave empty until approved.
PUBLIC_ADSENSE_CLIENT=
# Optional manual ad unit IDs. Leave empty to rely on AdSense Auto ads only.
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_CONTENT=
PUBLIC_ADSENSE_SLOT_BOTTOM=

# Analytics (pick one or both). Cloudflare Web Analytics is free and cookieless.
PUBLIC_GA4_ID=
PUBLIC_CF_ANALYTICS_TOKEN=

# Search console verification meta tags.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# Amazon Associates tracking IDs per marketplace (amazon.<key>). Missing ones fall back to .com.
PUBLIC_AMAZON_TAGS={"com":"nomore5mins-20"}

# Optional public contact email (the contact form works without it on Netlify).
PUBLIC_CONTACT_EMAIL=

# Comma-separated social profile URLs for structured data (Organization.sameAs).
PUBLIC_SOCIAL_PROFILES=
